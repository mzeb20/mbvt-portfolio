---
interface Props {
  currentPath: string;
  variant?: 'hero' | 'solid' | 'reading';
}

const { currentPath, variant = 'solid' } = Astro.props;

const links = [
  { href: '/fotografia', label: 'fotografía' },
  { href: '/escritura', label: 'escritura' },
  { href: '/exploraciones', label: 'exploraciones' },
  { href: '/contacto', label: 'contacto' },
];
---

<header class:list={['site-header', `header-${variant}`]}>
  <a href="/" class="site-name">Mercedes Bonavita</a>

  <!-- Desktop: "···" hover reveal -->
  <div class="desktop-menu">
    <button class="menu-trigger" aria-label="Abrir menú" aria-haspopup="true">···</button>
    <nav class="menu-list" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['menu-link', { active: currentPath === link.href }]}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile: hamburger -->
  <button class="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-overlay">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<!-- Mobile overlay -->
<div id="mobile-overlay" class="mobile-overlay" hidden>
  <nav aria-label="Navegación móvil">
    {links.map((link) => (
      <a href={link.href} class="mobile-link">{link.label}</a>
    ))}
  </nav>
</div>

<style>
  /* ─── Base header ─── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
  }

  .site-name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 500;
  }

  /* ─── Hero variant: transparent over image ─── */
  .site-header.header-hero {
    background: transparent;
  }

  .site-header.header-hero .site-name,
  .site-header.header-hero .menu-trigger {
    color: white;
    mix-blend-mode: difference;
  }

  .site-header.header-hero .hamburger span {
    background: white;
    mix-blend-mode: difference;
  }

  /* ─── Solid variant: white bar, dark text, fixed ─── */
  .site-header.header-solid {
    background: white;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .site-header.header-solid .site-name,
  .site-header.header-solid .menu-trigger {
    color: var(--color-text);
  }

  .site-header.header-solid .hamburger span {
    background: var(--color-text);
  }

  /* ─── Reading variant: white bar, dark text, scrolls with content ─── */
  .site-header.header-reading {
    position: static;
    background: white;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .site-header.header-reading .site-name,
  .site-header.header-reading .menu-trigger {
    color: var(--color-text);
  }

  .site-header.header-reading .hamburger span {
    background: var(--color-text);
  }

  /* ─── Desktop menu ─── */
  .desktop-menu {
    position: relative;
  }

  .menu-trigger {
    font-family: var(--font-ui);
    font-size: 1.5rem;
    padding: var(--space-1) var(--space-2);
    line-height: 1;
  }

  .menu-list {
    position: absolute;
    top: 100%;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: white;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    min-width: 200px;
    text-align: right;
  }

  .desktop-menu:hover .menu-list,
  .desktop-menu:focus-within .menu-list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .menu-link {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .menu-link.active {
    text-decoration: underline;
  }

  /* ─── Mobile hamburger ─── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 18px;
    padding: 0;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* ─── Mobile overlay ─── */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-overlay[hidden] {
    display: none;
  }

  .mobile-overlay nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: center;
  }

  .mobile-link {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text);
  }

  /* ─── Responsive switch ─── */
  @media (max-width: 768px) {
    .desktop-menu { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const hamburger = document.querySelector('.hamburger') as HTMLButtonElement;
  const overlay = document.getElementById('mobile-overlay') as HTMLElement;
  const mobileLinks = overlay.querySelectorAll('a');

  function openMenu() {
    overlay.hidden = false;
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    (mobileLinks[0] as HTMLAnchorElement)?.focus();
  }

  function closeMenu() {
    overlay.hidden = true;
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    hamburger.focus();
  }

  hamburger.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });
</script>