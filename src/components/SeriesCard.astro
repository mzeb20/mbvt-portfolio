---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  cover: ImageMetadata;
  href: string;
}

const { title, cover, href } = Astro.props;
---

<a href={href} class="series-card">
  <div class="series-card__image">
    <Image
      src={cover}
      alt=""
      widths={[400, 800, 1200]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <h2 class="series-card__title">{title}</h2>
</a>

<style>
  .series-card {
    display: block;
  }

  .series-card__image {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #f0f0f0;   /* placeholder color while image loads */
  }

  .series-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .series-card:hover .series-card__image :global(img) {
    transform: scale(1.03);
  }

  .series-card__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
  }
</style>