---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={`${title} — Mercedes Bonavita`} variant="reading">
  <main class="writing-detail">
    <article class="prose">
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</BaseLayout>

<style>
  .writing-detail {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .prose {
    max-width: 65ch;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .prose h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .prose p {
    margin-bottom: var(--space-3);
  }

  .prose em {
    font-style: italic;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    margin: var(--space-4) 0;
  }
</style>