---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
---

<BaseLayout title="Mercedes Bonavita">
  <Header currentPath={Astro.url.pathname} />

  <main class="hero">
    <Image
      src={heroImage}
      alt=""
      widths={[800, 1200, 1800, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-image"
    />
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 100svh;
    width: 100%;
    overflow: hidden;
  }

  .hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 768px) {
    .hero { height: 100dvh; }
  }
</style>