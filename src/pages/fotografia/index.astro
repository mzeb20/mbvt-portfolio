---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { resolveImage } from '../../utils/images';

const series = (await getCollection('fotografias')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Fotografía — Mercedes Bonavita">
  <main class="index">

    <div class="series-grid">
      {series.map((serie) => (
        <SeriesCard
          title={serie.data.title}
          cover={resolveImage(serie.data.cover)}
          href={`/fotografia/${serie.id}`}
        />
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .index {
  max-width: var(--page-max);
  margin: 0 auto;
  padding-left: var(--space-4);
  padding-right: var(--space-4);
  padding-bottom: var(--space-6);
  }

  .index h1 {
    margin-bottom: var(--space-6);
    font-family: var(--font-display);
    font-weight: 500;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>